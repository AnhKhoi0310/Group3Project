# ReviewLens backend configuration.
# Copy to backend/.env and fill in real values. Never commit backend/.env.
# Everything in this file is server-side only: none of it may reach the frontend.
# In CI and production, set these as real environment variables instead.

# Required. SQLAlchemy URL for the MySQL 8 database, including its password.
# Used when running the backend directly. Docker Compose builds its own URL
# from the MySQL values in the repository root .env file.
DATABASE_URL=mysql+pymysql://reviewlens:change-me@localhost:3306/reviewlens

# Required. Firebase project ID, from Firebase console > Project settings.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Required. Path to the Firebase Admin service account key file.
# Firebase console > Project settings > Service accounts > Generate new private key.
# Keep the file under backend/secrets/, which git ignores.
FIREBASE_CREDENTIALS_PATH=secrets/firebase-admin.json

# Required. API key for the commercial review-data provider.
REVIEW_PROVIDER_API_KEY=your-review-provider-api-key

# Optional. Comma-separated browser origins allowed to call this API.
# Defaults to the local frontend.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional. Maximum reviews collected per ingestion run, to protect provider quota.
# Must be a positive whole number. Defaults to 50.
INGESTION_MAX_REVIEWS=50
