# ReviewLens frontend configuration.
# Copy to frontend/.env and fill in real values. Never commit frontend/.env.
#
# Every VITE_ variable is bundled into browser code and visible to anyone.
# Only values designed to be public belong here (S1-BR-011). The Firebase web
# config below is public by design. Never add the Firebase Admin credential,
# the review provider key, or database credentials to this file.

# Base URL of the ReviewLens backend API.
VITE_API_BASE_URL=http://localhost:8000

# Firebase web app config, from Firebase console > Project settings > Your apps.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id
