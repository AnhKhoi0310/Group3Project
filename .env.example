# Docker Compose configuration for local development.
# Copy to .env in the repository root and choose your own values.

# Passwords for the local MySQL container. Avoid @ : / in these, because the
# application password is placed inside the database URL.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me

# Optional. Port on this computer for the MySQL container. Change it if another
# MySQL already uses 3306. Defaults to 3306.
MYSQL_HOST_PORT=3306
